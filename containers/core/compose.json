{
  "name": "${PROFILE_PROJECT}",
  "services": {
    "writer": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 128,
      "mem_limit": "512m",
      "cpus": 1.0,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=67108864,mode=1777"
      ],
      "networks": [
        "private"
      ],
      "image": "${PROFILE_IMAGE}",
      "user": "10001:10100",
      "environment": {
        "PROFILE_ROLE": "writer",
        "OW_EVIDENCE_ROOT": "/evidence",
        "OW_EVIDENCE_READ_GID": "10100"
