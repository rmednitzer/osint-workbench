        },
        {
          "type": "volume",
          "source": "state",
          "target": "/evidence",
          "read_only": false,
          "volume": {
            "nocopy": true,
            "subpath": "cas"
          }
        }
      ],
      "profiles": [
        "acceptance"
      ],
      "labels": {
        "org.osint-workbench.synthetic-run": "${PROFILE_RUN_ID}"
      },
      "cgroup": "private",
      "logging": {
        "driver": "json-file",
