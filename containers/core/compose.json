    "bootstrap": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 128,
      "mem_limit": "512m",
      "cpus": 1.0,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=67108864,mode=1777"
      ],
      "image": "${PROFILE_IMAGE}",
      "user": "0:0",
      "network_mode": "none",
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER"
      ],
      "entrypoint": [
        "/opt/venv/bin/python",
        "-I",
        "/opt/profile/bootstrap.py"
      ],
      "environment": {
        "PROFILE_RUN_ID": "${PROFILE_RUN_ID}"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "state",
          "target": "/state",
          "volume": {
            "nocopy": true
          }
        },
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/pgdata",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "profiles": [
        "acceptance"
      ],
      "labels": {
        "org.osint-workbench.synthetic-run": "${PROFILE_RUN_ID}"
      },
      "cgroup": "private",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
