    "db": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 128,
      "mem_limit": "512m",
      "cpus": 1.0,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=67108864,mode=1777",
        "/var/run/postgresql:rw,nosuid,size=8388608,uid=999,gid=999,mode=0770"
      ],
      "networks": [
        "private"
      ],
      "image": "pgvector/pgvector:pg18@sha256:2358fcba361ed2233a5ed81b5fe4ca779ccb304120ce531a3bf51c0ed7e2bc11",
      "user": "999:999",
      "environment": {
        "POSTGRES_USER": "profile_migration",
        "POSTGRES_DB": "workbench",
        "POSTGRES_PASSWORD_FILE": "/run/credential",
        "PGDATA": "/var/lib/postgresql/18/docker"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${PROFILE_STAGE}/credentials/migration",
          "target": "/run/credential",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "shm_size": "64m",
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "profile_migration",
          "-d",
          "workbench"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 30
      },
      "labels": {
        "org.osint-workbench.synthetic-run": "${PROFILE_RUN_ID}"
      },
      "cgroup": "private",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      }
    }
  },
  "networks": {
    "private": {
      "internal": true,
      "labels": {
        "org.osint-workbench.synthetic-run": "${PROFILE_RUN_ID}"
      }
    }
  },
  "volumes": {
    "state": {
      "external": true,
      "name": "${PROFILE_PROJECT}_state"
    },
    "pgdata": {
      "external": true,
      "name": "${PROFILE_PROJECT}_pgdata"
    }
  }
}
