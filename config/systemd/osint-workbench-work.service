# Requires the explicit shared-evidence profile and a separately scoped writer login.
[Unit]
Description=OSINT Workbench bounded document chunk worker
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=osint-workbench-worker
Group=osint-workbench-worker
SupplementaryGroups=osint-workbench-evidence
EnvironmentFile=/etc/osint-workbench-worker/runtime.env
Environment=OW_EVIDENCE_ROOT=/var/lib/osint-workbench/evidence
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/osint-workbench/venv/bin/osint-workbench work --max-jobs 32
WorkingDirectory=/
ReadOnlyPaths=/var/lib/osint-workbench/evidence
InaccessiblePaths=-/etc/osint-workbench -/etc/osint-workbench-health
UMask=0077
TimeoutStartSec=5min
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
Restart=no
MemoryMax=512M
TasksMax=16
CPUQuota=100%
LimitNOFILE=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
