# Production reference cadence. Disposable acceptance overrides this timing;
# an accelerated fixture pass does not verify the durations below.
[Unit]
Description=Schedule bounded OSINT Workbench API acquisition ticks

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
RandomizedDelaySec=15s
AccuracySec=1s
Unit=osint-workbench-collect-api.service

[Install]
WantedBy=timers.target
