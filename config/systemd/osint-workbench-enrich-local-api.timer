# Completion-relative bounded ticks; no overlapping invocation of this service.
[Unit]
Description=Schedule OSINT Workbench local API enrichment ticks

[Timer]
OnBootSec=3min
OnUnitInactiveSec=30s
RandomizedDelaySec=5s
AccuracySec=1s
Unit=osint-workbench-enrich-local-api.service

[Install]
WantedBy=timers.target
